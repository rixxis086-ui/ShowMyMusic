<Window x:Class="ShowMyMusic.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ShowMyMusic.Views.Controls"
        xmlns:helpers="clr-namespace:ShowMyMusic.Helpers"
        xmlns:models="clr-namespace:ShowMyMusic.Models"
        mc:Ignorable="d"
        Title="ShowMyMusic — Settings" 
        Height="780" Width="1040"
        MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0C0C12" 
        Foreground="#E4E4E7">

    <Window.Resources>
        <Style x:Key="SidebarNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="navBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#1A1A28"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#252238"/>
                                <Setter Property="Foreground" Value="#A855F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header & Live Preview Hero -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content -->
            <RowDefinition Height="*"/>
            <!-- Bottom Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Live Preview Hero -->
        <Border Grid.Row="0" Background="#11111A" BorderBrush="#202030" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" 
                                  Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ShowMyMusic" FontSize="17" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Active Track Overlay" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="16" Padding="12,8" BorderBrush="#28283C" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#09090F" Offset="0"/>
                                <GradientStop Color="#141422" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <controls:MusicCardControl x:Name="LivePreviewControl"
                                                   Track="{Binding PreviewTrack}"
                                                   Settings="{Binding Settings}"
                                                   Width="{Binding Settings.CardWidth}"
                                                   Height="{Binding Settings.CardHeight}"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Style="{StaticResource ModernPrimaryButton}" 
                            Command="{Binding TestShowOverlayCommand}" 
                            Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8 5v14l11-7z" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Test Overlay" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernSecondaryButton}" 
                            Command="{Binding NextSampleTrackCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" 
                                  Fill="#A1A1AA" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cycle Demo Track" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#0F0F17" BorderBrush="#202030" BorderThickness="0,0,1,0" Padding="14,16">
                <StackPanel>
                    <TextBlock Text="SETTINGS NAVIGATION" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="10,0,0,10"/>
                    
                    <RadioButton Content="🎨  Appearance &amp; Glass" 
                                 Style="{StaticResource SidebarNavButton}" 
                                 IsChecked="True" 
                                 GroupName="NavTabs"
                                 Checked="Nav_Appearance_Checked"/>
                    
                    <RadioButton Content="🖥  Position &amp; Displays" 
                                 Style="{StaticResource SidebarNavButton}" 
                                 GroupName="NavTabs"
                                 Checked="Nav_Position_Checked"/>
                    
                    <RadioButton Content="⚡  Animations &amp; Triggers" 
                                 Style="{StaticResource SidebarNavButton}" 
                                 GroupName="NavTabs"
                                 Checked="Nav_Animations_Checked"/>
                    
                    <RadioButton Content="⚙  System &amp; Backup" 
                                 Style="{StaticResource SidebarNavButton}" 
                                 GroupName="NavTabs"
                                 Checked="Nav_System_Checked"/>
                </StackPanel>
            </Border>
            <!-- Content Area -->
            <Grid Grid.Column="1" Background="#0C0C12">
                
                <!-- Page 1: Appearance -->
                <ScrollViewer x:Name="Page_Appearance" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        
                        <Border Style="{StaticResource ModernCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Preset Themes" Style="{StaticResource Heading2}"/>
                                    <TextBlock Text="Choose a curated visual style or save your custom configuration" Style="{StaticResource Subtext}" Margin="0,0,0,10"/>
                                    <ComboBox ItemsSource="{Binding Presets}" 
                                              SelectedItem="{Binding SelectedPreset}" 
                                              DisplayMemberPath="Name" 
                                              Width="280" 
                                              HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Content="💾 Save Preset" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Command="{Binding SaveCustomPresetCommand}"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Glass Material &amp; Geometry" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Customize surface opacity, glass material effect, and corner radii" Style="{StaticResource Subtext}" Margin="0,0,0,14"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Glass Material Type:" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding Settings.GlassStyle}" SelectionChanged="OnGlassStyleChanged" Width="260" HorizontalAlignment="Left">
                                        <models:GlassStyle>iOSFrostedGlass</models:GlassStyle>
                                        <models:GlassStyle>Win11Acrylic</models:GlassStyle>
                                        <models:GlassStyle>DarkGlass</models:GlassStyle>
                                        <models:GlassStyle>LightGlass</models:GlassStyle>
                                        <models:GlassStyle>Solid</models:GlassStyle>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Card Corner Radius (%):" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Settings.CornerRadiusCardPercent, Mode=TwoWay}" ValueChanged="OnVisualSliderChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.CornerRadiusCardPercent, StringFormat='{}{0:F0}%'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Artwork Corner Radius (%):" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Settings.CornerRadiusArtPercent, Mode=TwoWay}" ValueChanged="OnVisualSliderChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.CornerRadiusArtPercent, StringFormat='{}{0:F0}%'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Card Surface Opacity:" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="0.2" Maximum="1.0" Value="{Binding Settings.CardOpacity, Mode=TwoWay}" ValueChanged="OnVisualSliderChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.CardOpacity, StringFormat='{}{0:P0}'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Blur / Backdrop Radius:" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="60" Value="{Binding Settings.BlurRadius, Mode=TwoWay}" ValueChanged="OnVisualSliderChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.BlurRadius, StringFormat='{}{0:F0} px'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Colors &amp; Adaptive Glow" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Dynamic lighting matched to current playing track artwork" Style="{StaticResource Subtext}" Margin="0,0,0,12"/>

                                <CheckBox IsChecked="{Binding Settings.UseAdaptiveColor, Mode=TwoWay}" 
                                          Content="Adaptive Color Palette (extract dynamic tones from track cover)" 
                                          Click="OnAdaptiveColorCheckChanged"
                                          Margin="0,0,0,12"/>

                                <Border Background="#12121C" BorderBrush="#252538" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="✨ Neon Halo Glow Parameters" FontWeight="SemiBold" Foreground="#A855F7" Margin="0,0,0,8"/>

                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Glow Intensity:" Style="{StaticResource LabelText}"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1.0" Value="{Binding Settings.GlowIntensity, Mode=TwoWay}" ValueChanged="OnVisualSliderChanged"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Settings.GlowIntensity, StringFormat='{}{0:P0}'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Glow Radius (px):" Style="{StaticResource LabelText}"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding Settings.GlowRadius, Mode=TwoWay}" ValueChanged="OnVisualSliderChanged"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Settings.GlowRadius, StringFormat='{}{0:F0} px'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,4" Visibility="{Binding Settings.UseAdaptiveColor, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Background Color (HEX):" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.CustomBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" TextChanged="OnCustomColorTextChanged"/>
                                </Grid>

                                <Grid Margin="0,6" Visibility="{Binding Settings.UseAdaptiveColor, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Accent Color (HEX):" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.CustomAccentColor, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" TextChanged="OnCustomColorTextChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Dual State Element Configuration Card -->
                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Element Visibility (Dual-State Configuration)" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Configure which elements remain visible passively vs. revealed on hover" Style="{StaticResource Subtext}" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 1: Обычный вид (Пассивный) -->
                                    <Border Grid.Column="0" Background="#12121C" BorderBrush="#252538" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="🌙 Passive Mode (Always Visible)" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowArtworkPassive, Mode=TwoWay}" Content="Album Artwork" Margin="0,0,0,8" Click="OnDualStateCheckChanged"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowArtistPassive, Mode=TwoWay}" Content="Artist Name" Margin="0,0,0,8" Click="OnDualStateCheckChanged"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowProgressBarPassive, Mode=TwoWay}" Content="Timeline &amp; Progress Bar" Margin="0,0,0,8" Click="OnDualStateCheckChanged"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowVolumeBadgePassive, Mode=TwoWay}" Content="Volume Badge" Margin="0,0,0,8" Click="OnDualStateCheckChanged"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowMediaControlsPassive, Mode=TwoWay}" Content="Playback Controls" Click="OnDualStateCheckChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Column 2: При наведении мыши (Активный) -->
                                    <Border Grid.Column="2" Background="#12121C" BorderBrush="#252538" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="✨ Active Mode (On Mouse Hover)" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,0,10"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowArtworkActive, Mode=TwoWay}" Content="Album Artwork" Margin="0,0,0,8" Click="OnDualStateCheckChanged"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowArtistActive, Mode=TwoWay}" Content="Artist Name" Margin="0,0,0,8" Click="OnDualStateCheckChanged"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowProgressBarActive, Mode=TwoWay}" Content="Timeline &amp; Progress Bar" Margin="0,0,0,8" Click="OnDualStateCheckChanged"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowVolumeBadgeActive, Mode=TwoWay}" Content="Volume Badge" Margin="0,0,0,8" Click="OnDualStateCheckChanged"/>
                                            <CheckBox IsChecked="{Binding Settings.ShowMediaControlsActive, Mode=TwoWay}" Content="Playback Controls" Click="OnDualStateCheckChanged"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Page 2: Position -->
                <ScrollViewer x:Name="Page_Position" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        
                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Display Selection" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Select which screen to render the music overlay on" Style="{StaticResource Subtext}" Margin="0,0,0,10"/>
                                <ComboBox ItemsSource="{Binding Screens}" 
                                          SelectedItem="{Binding SelectedScreen}" 
                                          DisplayMemberPath="DisplayName" 
                                          Width="320" 
                                          HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Screen Placement &amp; Geometry" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Configure screen docking zones, margin offsets, and card dimensions" Style="{StaticResource Subtext}" Margin="0,0,0,12"/>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Screen Docking Zone:" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding Settings.SimpleZone}" SelectionChanged="OnPositionZoneChanged" HorizontalAlignment="Left" Width="240">
                                        <models:SimpleZone>Top</models:SimpleZone>
                                        <models:SimpleZone>Bottom</models:SimpleZone>
                                        <models:SimpleZone>Left</models:SimpleZone>
                                        <models:SimpleZone>Right</models:SimpleZone>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Horizontal Margin (X):" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Settings.MarginX, Mode=TwoWay}" ValueChanged="OnPositionSliderChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.MarginX, StringFormat='{}{0:F0} px'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Vertical Margin (Y):" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Settings.MarginY, Mode=TwoWay}" ValueChanged="OnPositionSliderChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.MarginY, StringFormat='{}{0:F0} px'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Card Width (px):" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="300" Maximum="550" Value="{Binding Settings.CardWidth, Mode=TwoWay}" ValueChanged="OnPositionSliderChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.CardWidth, StringFormat='{}{0:F0} px'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Card Height (px):" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="70" Maximum="140" Value="{Binding Settings.CardHeight, Mode=TwoWay}" ValueChanged="OnPositionSliderChanged"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.CardHeight, StringFormat='{}{0:F0} px'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page 3: Animations -->
                <ScrollViewer x:Name="Page_Animations" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        
                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Interaction Mode" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Interactive mode supports mouse hover and controls. Passive mode makes the overlay window completely click-through." Style="{StaticResource Subtext}" Margin="0,0,0,10"/>
                                
                                <ComboBox SelectedValue="{Binding Settings.InteractionMode}" Width="280" HorizontalAlignment="Left">
                                    <models:InteractionMode>Interactive</models:InteractionMode>
                                    <models:InteractionMode>Passive</models:InteractionMode>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Transitions &amp; Timing" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Customize entry/exit animation styles, transition speed, and auto-dismiss timer" Style="{StaticResource Subtext}" Margin="0,0,0,12"/>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Enter Animation:" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding Settings.EnterAnimation}" HorizontalAlignment="Left" Width="240">
                                        <models:AnimationType>SlideAndFade</models:AnimationType>
                                        <models:AnimationType>Slide</models:AnimationType>
                                        <models:AnimationType>Fade</models:AnimationType>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Exit Animation:" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding Settings.ExitAnimation}" HorizontalAlignment="Left" Width="240">
                                        <models:AnimationType>SlideAndFade</models:AnimationType>
                                        <models:AnimationType>Slide</models:AnimationType>
                                        <models:AnimationType>Fade</models:AnimationType>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Animation Speed (ms):" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="150" Maximum="800" Value="{Binding Settings.AnimationSpeedMs, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.AnimationSpeedMs, StringFormat='{}{0:F0} мс'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Auto-Dismiss Duration:" Style="{StaticResource LabelText}"/>
                                    <Slider Grid.Column="1" Minimum="1.0" Maximum="20.0" Value="{Binding Settings.DisplayDurationSeconds, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.DisplayDurationSeconds, StringFormat='{}{0:F1} с'}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <CheckBox IsChecked="{Binding Settings.IsPinned, Mode=TwoWay}" 
                                          Content="Pin on Screen (Always Visible — never auto-hide)" 
                                          Foreground="#60A5FA" 
                                          FontWeight="SemiBold" 
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Auto-Show Event Triggers" Style="{StaticResource Heading2}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox IsChecked="{Binding Settings.ShowOnTrackChange, Mode=TwoWay}" Content="On Track Change" Margin="0,0,24,10"/>
                                    <CheckBox IsChecked="{Binding Settings.ShowOnVolumeChange, Mode=TwoWay}" Content="On Volume Change" Margin="0,0,24,10"/>
                                    <CheckBox IsChecked="{Binding Settings.ShowOnPlayPause, Mode=TwoWay}" Content="On Play / Pause" Margin="0,0,24,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page 4: System -->
                <ScrollViewer x:Name="Page_System" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        
                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Windows Integration" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Automatically launch application on system logon" Style="{StaticResource Subtext}" Margin="0,0,0,10"/>
                                <CheckBox IsChecked="{Binding Settings.Autostart, Mode=TwoWay}" 
                                          Content="Start ShowMyMusic with Windows (minimized to system tray)" 
                                          FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Global Shortcut Hotkey" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Toggle overlay visibility on demand over any full-screen game or app" Style="{StaticResource Subtext}" Margin="0,0,0,12"/>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Modifier Keys:" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.HotkeyModifiers}" Width="200" HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hotkey Key:" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.HotkeyKey}" Width="200" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Configuration Backup &amp; Restore" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="Export or import your theme and overlay presets as JSON" Style="{StaticResource Subtext}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📤 Export Settings (JSON)" Style="{StaticResource ModernSecondaryButton}" Command="{Binding ExportSettingsCommand}" Margin="0,0,10,0"/>
                                    <Button Content="📥 Import Settings (JSON)" Style="{StaticResource ModernSecondaryButton}" Command="{Binding ImportSettingsCommand}" Margin="0,0,10,0"/>
                                    <Button Content="↺ Reset Defaults" Style="{StaticResource ModernSecondaryButton}" Command="{Binding ResetDefaultsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#11111A" BorderBrush="#202030" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="ShowMyMusic v1.0.0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Apply &amp; Close" 
                            Style="{StaticResource ModernPrimaryButton}" 
                            Click="ApplyAndClose_Click" 
                            Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>