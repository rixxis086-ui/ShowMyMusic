<UserControl x:Class="ShowMyMusic.Views.Controls.MusicCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:ShowMyMusic.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="88" d:DesignWidth="380"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVis"/>
        <helpers:PercentToCornerRadiusConverter x:Key="PercentToCornerRadius"/>
        <helpers:PercentToRadiusConverter x:Key="PercentToRadius"/>
        <helpers:HexToBrushConverter x:Key="HexToBrush"/>
        <helpers:PlayPauseIconConverter x:Key="PlayPauseIcon"/>
        <helpers:ProgressWidthConverter x:Key="ProgressWidth"/>
        
        <!-- Glass Theme Converters -->
        <helpers:GlassBackgroundConverter x:Key="GlassBgConv"/>
        <helpers:GlassBorderBrushConverter x:Key="GlassBorderConv"/>
        <helpers:GlassSpecularVisibilityConverter x:Key="GlassSpecularVisConv"/>
        <helpers:GlassForegroundConverter x:Key="GlassFgConv"/>
        <helpers:GlassSubtextForegroundConverter x:Key="GlassSubtextFgConv"/>
        <helpers:GlassBadgeBackgroundConverter x:Key="GlassBadgeBgConv"/>

        <!-- Mini Media Control Button -->
        <Style x:Key="MiniMediaBtn" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <!-- 1. Adaptive Neon Glow Layer -->
        <Border x:Name="GlowEmitterBorder"
                IsHitTestVisible="False"
                Visibility="{Binding Settings.AdaptiveGlowEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
            <Border.CornerRadius>
                <MultiBinding Converter="{StaticResource PercentToCornerRadius}">
                    <Binding Path="Settings.CornerRadiusCardPercent" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Settings.CardHeight" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                </MultiBinding>
            </Border.CornerRadius>
            <Border.Background>
                <SolidColorBrush Color="{Binding Track.AccentColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=#8B5CF6}"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect 
                    Color="{Binding Track.AccentColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=#8B5CF6}"
                    BlurRadius="{Binding Settings.GlowRadius, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=35}"
                    Opacity="{Binding Settings.GlowIntensity, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=0.85}"
                    ShadowDepth="0"
                    RenderingBias="Quality"/>
            </Border.Effect>
        </Border>

        <!-- 2. Main Card Surface with Dynamic Glass Materials & Border -->
        <Border x:Name="CardBorder"
                BorderThickness="{Binding Settings.BorderWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
            
            <Border.CornerRadius>
                <MultiBinding Converter="{StaticResource PercentToCornerRadius}">
                    <Binding Path="Settings.CornerRadiusCardPercent" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                </MultiBinding>
            </Border.CornerRadius>

            <Border.Background>
                <MultiBinding Converter="{StaticResource GlassBgConv}">
                    <Binding Path="Settings.GlassStyle" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Settings.CardOpacity" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Settings.CustomBackgroundColor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Track.AccentColor"/>
                    <Binding Path="Settings.UseAdaptiveColor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                </MultiBinding>
            </Border.Background>

            <Border.BorderBrush>
                <MultiBinding Converter="{StaticResource GlassBorderConv}">
                    <Binding Path="Settings.GlassStyle" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Settings.BorderColor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                </MultiBinding>
            </Border.BorderBrush>

            <!-- Inner Layout -->
            <Grid>
                <!-- Liquid Glass Specular Glaze Layer (Visible for iOS/Win11/Light, Hidden for Solid) -->
                <Border CornerRadius="{Binding CornerRadius, ElementName=CardBorder}" 
                        Visibility="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassSpecularVisConv}}"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                            <GradientStop Color="#0AFFFFFF" Offset="0.38"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.75"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="12,10,14,10">
                    <Grid.ColumnDefinitions>
                        <!-- Artwork Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Info & Progress Column -->
                        <ColumnDefinition Width="*"/>
                        <!-- Volume & Controls Column -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Artwork Thumbnail with True Rounded Corners -->
                    <Grid x:Name="ArtworkContainer" 
                          Grid.Column="0" 
                          Width="64" Height="64" 
                          Margin="0,0,12,0">
                        
                        <!-- Fallback Gradient with Note (Visible when no album art) -->
                        <Rectangle Width="64" Height="64"
                                   Visibility="{Binding Track.Thumbnail, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}">
                            <Rectangle.RadiusX>
                                <MultiBinding Converter="{StaticResource PercentToRadius}">
                                    <Binding Path="Settings.CornerRadiusArtPercent" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Rectangle.RadiusX>
                            <Rectangle.RadiusY>
                                <MultiBinding Converter="{StaticResource PercentToRadius}">
                                    <Binding Path="Settings.CornerRadiusArtPercent" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Rectangle.RadiusY>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Fallback Note Icon -->
                        <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" 
                              Fill="White" 
                              Width="26" Height="26" 
                              Stretch="Uniform" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              Visibility="{Binding Track.Thumbnail, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}"/>

                        <!-- Real Album Artwork with True Anti-Aliased Rounded Corners -->
                        <Rectangle Width="64" Height="64"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding Track.Thumbnail, Converter={StaticResource NullToVis}}">
                            <Rectangle.RadiusX>
                                <MultiBinding Converter="{StaticResource PercentToRadius}">
                                    <Binding Path="Settings.CornerRadiusArtPercent" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Rectangle.RadiusX>
                            <Rectangle.RadiusY>
                                <MultiBinding Converter="{StaticResource PercentToRadius}">
                                    <Binding Path="Settings.CornerRadiusArtPercent" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Rectangle.RadiusY>
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Track.Thumbnail}" Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <!-- 2. Track Title, Artist, Timeline & Progress Bar -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title & Source App Badge Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="{Binding Track.Title}" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassFgConv}}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>

                            <Border Grid.Column="1" 
                                    Background="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassBadgeBgConv}}" 
                                    CornerRadius="6" 
                                    Padding="6,2" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Track.AppSource}" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="110"
                                           Foreground="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassFgConv}}"/>
                            </Border>
                        </Grid>

                        <!-- Artist Name -->
                        <TextBlock x:Name="ArtistTextBlock" 
                                   Grid.Row="1" 
                                   Text="{Binding Track.Artist}" 
                                   FontSize="12" 
                                   Foreground="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassSubtextFgConv}}" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4"/>

                        <!-- Progress Bar & Time Stamps -->
                        <Grid x:Name="ProgressBarContainer" 
                              Grid.Row="2" 
                              Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="{Binding Track.PositionFormatted}" 
                                       FontSize="10" 
                                       Foreground="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassSubtextFgConv}}" 
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>

                            <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                                <!-- Track background -->
                                <Border Background="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassBadgeBgConv}}"
                                        CornerRadius="2"/>
                                <!-- Fill: width proportional to progress -->
                                <Border CornerRadius="2" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Track.AccentColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=#8B5CF6}"/>
                                    </Border.Background>
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressWidth}">
                                            <Binding Path="Track.ProgressPercent" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Column="2" 
                                       Text="{Binding Track.DurationFormatted}" 
                                       FontSize="10" 
                                       Foreground="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassSubtextFgConv}}" 
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- 3. Volume Badge & Playback Buttons -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Vertical" 
                                VerticalAlignment="Center" 
                                Margin="10,0,0,0">
                        
                        <!-- Volume Pill Badge -->
                        <Border x:Name="VolumeContainer" 
                                Background="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassBadgeBgConv}}" 
                                CornerRadius="8" 
                                Padding="7,3" 
                                HorizontalAlignment="Right"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" 
                                      Fill="{Binding Track.AccentBrush, FallbackValue=#8B5CF6}" 
                                      Width="11" Height="11" 
                                      Stretch="Uniform" 
                                      Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Track.VolumePercent, StringFormat='{}{0}%'}" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassFgConv}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Interactive Playback Controls -->
                        <StackPanel x:Name="ControlsContainer" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right">
                            
                            <Button Style="{StaticResource MiniMediaBtn}" 
                                    Background="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassBadgeBgConv}}"
                                    Command="{Binding SkipPreviousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Предыдущий трек"
                                    Width="26" Height="26" 
                                    Margin="2,0">
                                <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" 
                                      Fill="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassFgConv}}" 
                                      Width="10" Height="10" 
                                      Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource MiniMediaBtn}" 
                                    Background="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassBadgeBgConv}}"
                                    Command="{Binding TogglePlayPauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Воспроизведение / Пауза"
                                    Width="28" Height="28" 
                                    Margin="2,0">
                                <Path Data="{Binding Track.IsPlaying, Converter={StaticResource PlayPauseIcon}}" 
                                      Fill="{Binding Track.AccentBrush, FallbackValue=White}" 
                                      Width="12" Height="12" 
                                      Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource MiniMediaBtn}" 
                                    Background="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassBadgeBgConv}}"
                                    Command="{Binding SkipNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Следующий трек"
                                    Width="26" Height="26" 
                                    Margin="2,0">
                                <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" 
                                      Fill="{Binding Settings.GlassStyle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlassFgConv}}" 
                                      Width="10" Height="10" 
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>